# Copy to .env (repo root) and fill in. .env is gitignored: never commit keys.

# Delivery mode: off (default, nothing is sent) | redirect (everything to DEMO_INBOX) | live (to the address you type)
OUTBOUND_MODE=off

# Resend: create a free account at resend.com -> API Keys -> Create (sending access is enough)
RESEND_API_KEY=

# Sender. Resend's test sender only delivers to the email address you signed up to Resend with.
# To send to other addresses, verify a domain in Resend (DNS records) and use an address on it,
# e.g. RESEND_FROM=Yakob <hello@your-domain.com>
RESEND_FROM=Conversion Engine <onboarding@resend.dev>

# Redirect mode delivers here (with the test sender: must be your Resend signup address)
DEMO_INBOX=

# Replies (agent/reply_inbox.py). The test sender cannot receive mail, so every email carries a Reply-To
# pointing at your own inbox; a plus-address keeps replies separate, e.g. REPLY_TO=you+replies@gmail.com
# The watcher reads that inbox over IMAP. Gmail: turn on 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and paste it below. Never your normal password.
REPLY_TO=
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# REPLY_POLL_SECONDS=15

# How the email is signed (applied before the judge, so what is judged is what is sent)
SENDER_NAME=Yakob Dereje
SENDER_TITLE=Research Partner
BOOKING_URL=https://cal.com/tenacious/15min
SENDER_WEBSITE=gettenacious.com

# LLM writer (composer v3): uses the Week 11 teacher prompt via OpenRouter.
# OPENROUTER_API_KEY is read from here, or from the Week 11 repo's .env if not set.
# LIVE_DESK_MODEL=meta-llama/llama-3.3-70b-instruct
# LIVE_DESK_BUDGET_USD=0.50

# Optional live-mode allowlist: comma-separated addresses or @domains. Empty = any valid address.
ALLOWED_RECIPIENTS=

# Where the Week 11 evaluator lives (default: ../The_Sales_Agent_Evaluation_Bench)
# TB_DIR=

# Autopilot (fixed emails that pass final verification are sent automatically; set 1 to review them too)
# AUTOPILOT_APPROVE_FIXED=0
# AUTOPILOT_MAX_PER_RUN=10
# AUTOPILOT_SEND_DELAY_S=2
